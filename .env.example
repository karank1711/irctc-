# Copy this file to .env and replace every placeholder.
# The application reads .env from the project root. Java does not load it automatically.
# Never commit the real .env file.

# MySQL connection. Create the database before starting, or use docker compose.
DB_URL=jdbc:mysql://127.0.0.1:3306/irctc_admin?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Kolkata
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Development administrator. The password is hashed with BCrypt before it is stored.
# The account is created only when this email does not already exist.
# Change both values before any shared or production deployment.
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=replace-with-a-long-password

# true creates tables on startup. Sample business rows are not inserted.
SEED_SAMPLE_DATA=false
DB_AUTO_INIT=true

PORT=8080
